# Generate two different random values with openssl rand -hex 32.
APP_SECRET=
POSTGRES_PASSWORD=
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
COOKIE_SECURE=0
ALLOW_REGISTRATION=1

# Remote OpenAI-compatible providers remain disabled until keys are set.
STT_PROVIDER=remote
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
LLM_PROVIDER=remote
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional container build dependencies.
LOCAL_WHISPER=0
WHISPER_MODEL=small
FACE_TRACKING=0
ENABLE_FACE_TRACKING=0

# Comma-separated exact approved hostnames for direct HTTPS video imports.
MEDIA_URL_HOSTS=
MAX_UPLOAD_MB=1024
MAX_VIDEO_SECONDS=7200
MAX_ACTIVE_JOBS=2
MAX_DAILY_JOBS=25
MAX_CLIPS=10
SCORE_WEIGHTS=3,2,1,4
S3_BUCKET=
S3_ENDPOINT_URL=

# Optional USD rates. Leave unset for unknown costs.
# STT_COST_PER_MINUTE=0
# LLM_COST_PER_MILLION_PROMPT_TOKENS=0
# LLM_COST_PER_MILLION_COMPLETION_TOKENS=0

# Opt in only where users may fetch public direct media URLs. Allowlist takes precedence.
ALLOW_PUBLIC_MEDIA_URLS=0
